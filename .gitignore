# ─────────────────────────────────────────
# Secrets / environment
# ─────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─────────────────────────────────────────
# Node / Next.js
# ─────────────────────────────────────────

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/.next/
/out/
/build
/coverage
.vercel
*.tsbuildinfo
next-env.d.ts

# package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────
# Python / Django
# ─────────────────────────────────────────

# byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# virtual environments
env/
venv/
.venv/
ENV/

# local database
db.sqlite3
db.sqlite3-journal
*.sqlite3

# user uploads (keep folder, ignore contents)
/media/*
!/media/.gitkeep

# collectstatic output (regenerated on deploy)
/staticfiles/
/static_root/

# packaging
dist/
*.egg-info/
.eggs/

# test / type-check caches
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/

local_settings.py

